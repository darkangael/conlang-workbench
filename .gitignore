# Dependencies
node_modules/

# Build output (main.js is committed for releases, but ignore during dev if you prefer)
# main.js

# Editor / OS cruft
.DS_Store
*.log
.vscode/
.idea/

# Test build artifacts
/tmp/conlang-test/

# Obsidian local config if someone clones into a vault
.obsidian/

# Lockfile is committed for reproducible builds.
# (Earlier versions of this gitignore excluded it, which the Obsidian
# community plugin review flagged — committing the lockfile ensures
# dependency resolution is reproducible across environments.)

# Local agent scratch
.claude/
issue16-reply.md

# Conlang Workbench test-vault
# Keep shareable Obsidian configuration while ignoring machine-local state.

test-vault/.obsidian/workspace.json
test-vault/.obsidian/workspace-mobile.json

# OS-generated files
Thumbs.db

# Temporary / backup files
*~
*.tmp
*.swp

# Local real-language integration testing
# Mer is copied from the private Conlangs vault for testing Conlang Workbench.
# It is not repository test data and should never be committed.
test-vault/Languages/Mer/

# FUSE temporary files created when open files are removed
.fuse_hidden*
