{
  "name": "conlang-workbench",
  "version": "0.21.1",
  "description": "An Obsidian workbench for constructing, documenting, and exploring constructed languages.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "lint": "eslint \"**/*.ts\"",
    "test:vault-paths": "node scripts/test-vault-paths.mjs",
    "test:frontmatter": "node scripts/test-frontmatter-parsing.mjs",
    "test:body-preview": "node scripts/test-body-preview.mjs",
    "test:lexical-senses": "node scripts/test-lexical-senses.mjs",
    "test:selection-lookup": "node scripts/test-selection-lookup.mjs",
    "test:gloss-rendering": "node scripts/test-gloss-rendering.mjs",
    "test:lexical-normalization": "node scripts/test-lexical-normalization.mjs",
    "test:lookup-query": "node scripts/test-lookup-query.mjs",
    "test:word-scan": "node scripts/test-word-scan.mjs",
    "test:settings-validation": "node scripts/test-settings-validation.mjs",
    "test:persisted-setting-state": "node scripts/test-persisted-setting-state.mjs",
    "test:dictionary-entry-writer": "node scripts/test-dictionary-entry-writer.mjs",
    "test:dictionary-language-scope": "node scripts/test-dictionary-language-scope.mjs",
    "test:inflection-language-scope": "node scripts/test-inflection-language-scope.mjs",
    "test:translation-commit-plan": "node scripts/test-translation-commit-plan.mjs",
    "test:translation-vocabulary-repair": "node scripts/test-translation-vocabulary-repair.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "conlang",
    "constructed-language",
    "worldbuilding",
    "ttrpg",
    "dictionary",
    "lexicon"
  ],
  "author": "darkangael",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^16.18.126",
    "@typescript-eslint/parser": "^8.61.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "^1.13.0",
    "tslib": "^2.4.0",
    "typescript": "^4.9.5"
  }
}
